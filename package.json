{
  "name": "stripe-express-connect",
  "version": "0.1.0",
  "description": "Configurable React and Express building blocks for Stripe Connect Express onboarding and Checkout.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/server/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["stripe", "connect", "express", "checkout", "react"]
}
